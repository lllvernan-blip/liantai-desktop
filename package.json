{
  "name": "liantai-desktop",
  "version": "0.0.12",
  "private": true,
  "description": "练习台桌面版（Electron 壳）",
  "main": "main.js",
  "author": "lllvernan",
  "scripts": {
    "start": "electron .",
    "dist": "node tools/stamp-build.mjs && electron-builder --win nsis --publish never",
    "release": "node tools/release.mjs"
  },
  "build": {
    "appId": "com.lllvernan.liantai",
    "productName": "练习台",
    "directories": {
      "output": "dist"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "files": [
      "main.js",
      "update.js",
      "app/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "练习台-Setup-${version}.exe",
      "shortcutName": "练习台",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "lllvernan-blip",
        "repo": "liantai-desktop",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "40.10.2",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
