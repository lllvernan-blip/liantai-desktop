{
  "name": "liantai-desktop",
  "version": "0.0.17",
  "private": true,
  "description": "综应、申论的练习与批改",
  "main": "main.js",
  "author": "lllvernan",
  "scripts": {
    "start": "electron .",
    "dist": "node tools/stamp-build.mjs && electron-builder --win nsis --publish never",
    "dist:mac": "node tools/stamp-build.mjs && ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --mac --publish never",
    "icon:mac": "python3 tools/make-mac-icon.py",
    "release": "node tools/release.mjs",
    "release:mac": "node tools/release-mac.mjs",
    "release:check": "node tools/release-check.mjs"
  },
  "build": {
    "appId": "com.lllvernan.liantai",
    "productName": "练习台",
    "directories": {
      "output": "dist"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "files": [
      "main.js",
      "update.js",
      "app/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "练习台-Setup-${version}.exe",
      "shortcutName": "练习台",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.education",
      "identity": null,
      "target": [
        { "target": "dmg", "arch": ["arm64"] },
        { "target": "zip", "arch": ["arm64"] }
      ],
      "artifactName": "liantai-desktop-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "练习台 ${version}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "lllvernan-blip",
        "repo": "liantai-desktop",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "40.10.2",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
