{
  "name": "liantai-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "综应练习台桌面版（Electron 壳）",
  "main": "main.js",
  "author": "lllvernan",
  "scripts": {
    "start": "electron .",
    "dist": "node tools/stamp-build.mjs && electron-builder --win portable"
  },
  "build": {
    "appId": "com.lllvernan.liantai",
    "productName": "综应练习台",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "app/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "综应练习台.exe"
    }
  },
  "devDependencies": {
    "electron": "40.10.2",
    "electron-builder": "^26.0.0"
  }
}
